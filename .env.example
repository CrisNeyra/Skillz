# Shared / Backend
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://skillz:skillz@localhost:5432/skillz
# Sin Docker: usa SQLite local
# DATABASE_URL=sqlite:///./skillz.db
# En production: JWT_SECRET aleatorio >= 32 chars (obligatorio)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
# Si estánías CLOUDINARY_*, los uploads van a Cloudinary.
# Si no, el API guarda archivos en apps/api/uploads (modo local).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=skillz

# Frontend (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://localhost:8000
