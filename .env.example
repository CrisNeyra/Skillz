# Shared / Backend
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://skillz:skillz@localhost:5432/skillz
# Sin Docker: usa SQLite local
# DATABASE_URL=sqlite:///./skillz.db
# En production: JWT_SECRET aleatorio >= 32 chars (obligatorio)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Incluí localhost y el dominio Vercel en production (coma-separados)
CORS_ORIGINS=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
# Redis opcional (Upstash / Railway). Sin REDIS_URL usa rate limit in-memory.
REDIS_URL=
# Sentry opcional (API)
SENTRY_DSN=
# AI opcional — sin key usa heurística local determinística
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Si llenás CLOUDINARY_*, los uploads van a Cloudinary.
# Si no, el API guarda archivos en apps/api/uploads (modo local).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=skillz

# Frontend (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://localhost:8000
# Prefill login demo: true | false. Si se omite, solo en NODE_ENV=development.
# En Vercel production: NEXT_PUBLIC_DEMO_LOGIN=false
NEXT_PUBLIC_DEMO_LOGIN=
# Seed de usuario demo (test@test.com) solo si SEED_DEMO_USER=true y API local.
SEED_DEMO_USER=true
